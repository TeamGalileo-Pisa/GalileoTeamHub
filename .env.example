# Variabili pubbliche: i valori VITE_* vengono inclusi nel bundle del browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
VITE_AUTH_EMAIL_DOMAIN=auth.teamgalileo.local
VITE_APP_TIMEZONE=Europe/Rome

# Segreti server-side da configurare con `supabase secrets set`, mai in Netlify/Vite.
# AUTH_EMAIL_DOMAIN=auth.teamgalileo.local
# EMAIL_PROVIDER=development
# Mittente applicativo: Team Galileo Pisa <info.teamgalileo@gmail.com>
# Per l'invio reale impostare EMAIL_PROVIDER=gmail e configurare in Supabase:
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# APP_ORIGINS=http://localhost:5173,https://your-site.netlify.app

# Solo per lo script locale di bootstrap; usare `.env.bootstrap.local`, che è ignorato da Git.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# Fallback per progetti che usano ancora la chiave JWT legacy:
# SUPABASE_SERVICE_ROLE_KEY=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_SOFTWARE_PASSWORD=
# BOOTSTRAP_ELETTRONICA_PASSWORD=
# BOOTSTRAP_BRACCIO_PASSWORD=
# BOOTSTRAP_ROVER_PASSWORD=
# BOOTSTRAP_GEOLOGIA_PASSWORD=
# BOOTSTRAP_BIOLOGIA_PASSWORD=
# BOOTSTRAP_LOGISTICA_PASSWORD=
# BOOTSTRAP_BUSINESS_PASSWORD=
# BOOTSTRAP_COMUNICAZIONE_PASSWORD=
